{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Main CEVRA Vids window with narrow application commands, including offline draft query/revision. Native host plugins remain Rust-only.",
  "windows": ["main"],
  "permissions": [
    "allow-desktop-edit-manual-video-sequence",
    "allow-desktop-get-close-state",
    "allow-desktop-get-media-drop-state",
    "allow-desktop-import-dropped-media",
    "allow-desktop-retry-checkpoint",
    "allow-desktop-get-state",
    "allow-desktop-pick-and-ingest-media",
    "allow-desktop-transcribe-source",
    "allow-desktop-undo",
    "allow-desktop-redo",
    "allow-desktop-cancel-operation",
    "allow-desktop-get-editorial-draft",
    "allow-desktop-revise-editorial-draft",
    "allow-desktop-thumbnail-local-video",
    "allow-desktop-preview-local-video",
    "allow-desktop-prepare-manual-export",
    "allow-desktop-export-manual-sequence",
    "allow-desktop-preview-manual-sequence-conform",
    "allow-desktop-create-manual-video-clip",
    "allow-desktop-trim-manual-video-clip"
  ]
}
