{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CEVRA Vids",
  "version": "0.1.0",
  "identifier": "com.cevra.vids",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CEVRA Vids",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#0d0f12"
      }
    ],
    "security": {
      "capabilities": ["main-window"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
